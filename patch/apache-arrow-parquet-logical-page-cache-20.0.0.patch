+TEST_F(TestPageSerde, WithoutOffsetIndexPageCacheAvoidsReadsAndPreservesMissOffset) {
+  constexpr int32_t kPageDataSize = 4;
+  data_page_header_.num_values = 1;
+
+  ASSERT_NO_FATAL_FAILURE(
+      WriteDataPageHeader(/*max_serialized_len=*/1024, kPageDataSize, kPageDataSize));
+  ASSERT_OK(out_stream_->Write("one1", kPageDataSize));
+  ASSERT_OK_AND_ASSIGN(const int64_t first_page_end, out_stream_->Tell());
+  ASSERT_NO_FATAL_FAILURE(
+      WriteDataPageHeader(/*max_serialized_len=*/1024, kPageDataSize, kPageDataSize));
+  ASSERT_OK(out_stream_->Write("two2", kPageDataSize));
+  EndStream();
+
+  struct CacheEntry {
+    std::shared_ptr<Buffer> buffer;
+    bool is_decompressed = false;
+  };
+  std::unordered_map<int64_t, CacheEntry> cache;
+  std::vector<std::pair<int64_t, int64_t>> cache_hits;
+  ReaderProperties properties;
+  properties.set_page_read_mode_func([] { return PageReadMode::WITHOUT_OFFSET_INDEX; });
+  properties.set_without_offset_index_cache_lookup_func(
+      [&](int64_t page_offset, std::shared_ptr<Buffer>& buffer, bool& cache_hit,
+          bool& is_decompressed) {
+        const auto iter = cache.find(page_offset);
+        cache_hit = iter != cache.end();
+        if (cache_hit) {
+          buffer = iter->second.buffer;
+          is_decompressed = iter->second.is_decompressed;
+        } else {
+          buffer.reset();
+          is_decompressed = false;
+        }
+        return 0;
+      });
+  properties.set_without_offset_index_cache_insert_func(
+      [&](int64_t page_offset, int64_t physical_page_size, bool is_decompressed,
+          const std::shared_ptr<Buffer>& buffer) {
+        EXPECT_GT(physical_page_size, kPageDataSize);
+        auto copied = buffer->CopySlice(0, buffer->size());
+        if (!copied.ok()) {
+          return -1;
+        }
+        cache[page_offset] = {std::move(copied).ValueOrDie(), is_decompressed};
+        return 0;
+      });
+  properties.set_without_offset_index_cache_hit_func(
+      [&](int64_t page_offset, int64_t physical_page_size) {
+        cache_hits.emplace_back(page_offset, physical_page_size);
+      });
+
+  std::vector<int64_t> reads;
+  properties.set_without_offset_index_read_range_func(
+      [&](int64_t offset, int64_t length, int64_t end, std::shared_ptr<Buffer>& buffer) {
+        EXPECT_EQ(end, out_buffer_->size());
+        EXPECT_GE(offset, 0);
+        EXPECT_LE(length, end - offset);
+        reads.push_back(offset);
+        buffer = std::make_shared<Buffer>(out_buffer_, offset, length);
+        return 0;
+      });
+  auto open_reader = [&] {
+    // There deliberately is no InputStream: even a cache miss uses PageMgr.
+    return PageReader::Open(nullptr, 2, Compression::UNCOMPRESSED, properties, false,
+                            nullptr, 0, out_buffer_->size());
+  };
+  auto cold_reader = open_reader();
+  auto first_page = cold_reader->NextPage();
+  ASSERT_EQ("one1", std::string_view(*first_page->buffer()));
+  ASSERT_EQ("two2", std::string_view(*cold_reader->NextPage()->buffer()));
+  ASSERT_EQ(nullptr, cold_reader->NextPage());
+  ASSERT_FALSE(reads.empty());
+  ASSERT_EQ(2U, cache.size());
+  // The first buffer remains valid after reading the following page.
+  ASSERT_EQ("one1", std::string_view(*first_page->buffer()));
+
+  reads.clear();
+  auto hot_reader = open_reader();
+  ASSERT_EQ("one1", std::string_view(*hot_reader->NextPage()->buffer()));
+  ASSERT_EQ("two2", std::string_view(*hot_reader->NextPage()->buffer()));
+  ASSERT_TRUE(reads.empty());
+  ASSERT_EQ(2U, cache_hits.size());
+
+  reads.clear();
+  cache_hits.clear();
+  cache.erase(first_page_end);
+  auto partial_reader = open_reader();
+  ASSERT_EQ("one1", std::string_view(*partial_reader->NextPage()->buffer()));
+  ASSERT_EQ("two2", std::string_view(*partial_reader->NextPage()->buffer()));
+  ASSERT_EQ(first_page_end, reads.front());
+  ASSERT_EQ((std::vector<std::pair<int64_t, int64_t>>{{0, first_page_end}}), cache_hits);
+
+  reads.clear();
+  cache[0] = {Buffer::FromString("not-a-page"), false};
+  auto invalid_reader = open_reader();
+  ASSERT_EQ("one1", std::string_view(*invalid_reader->NextPage()->buffer()));
+  ASSERT_EQ("two2", std::string_view(*invalid_reader->NextPage()->buffer()));
+  ASSERT_EQ(0, reads.front());
+
+  cache.clear();
+  properties.set_without_offset_index_read_range_func(
+      [](int64_t, int64_t, int64_t, std::shared_ptr<Buffer>&) { return -1; });
+  auto failed_reader = open_reader();
+  ASSERT_THROW(failed_reader->NextPage(), ParquetException);
+}
