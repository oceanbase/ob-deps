+void SerializedPageReader::FillWithoutOffsetIndexCache(
+    const int64_t page_offset, const int64_t compressed_len,
+    const std::shared_ptr<Buffer>& compressed_page_data,
+    const std::shared_ptr<Buffer>& page_data) const {
+  const bool decompression_happened =
+      page_data.get() != compressed_page_data.get();
+  // Match PageMgr's admission policy: keep the decompressed payload only when
+  // it does not expand cache memory by 1.5x or more.
+  const bool is_decompressed =
+      decompression_happened &&
+      page_data->size() < compressed_len + compressed_len / 2;
+  const std::shared_ptr<Buffer>& data_to_cache =
+      is_decompressed ? page_data : compressed_page_data;
+  const int64_t page_header_size = tmp_page_header_cache_buffer_->size();
+  if (data_to_cache->size() >
+      std::numeric_limits<int64_t>::max() - page_header_size) {
+    return;
+  }
+
+  const auto resize_status =
+      tmp_page_buffer_->Resize(page_header_size + data_to_cache->size(), false);
+  if (!resize_status.ok()) {
+    return;
+  }
+  uint8_t* cache_data = tmp_page_buffer_->mutable_data();
+  memcpy(cache_data, tmp_page_header_cache_buffer_->data(), page_header_size);
+  memcpy(cache_data + page_header_size, data_to_cache->data(),
+         data_to_cache->size());
+
+  // The cache is an optional optimization. Cache admission failures must not
+  // fail the Parquet scan.
+  try {
+    const int ret = properties_.without_offset_index_cache_insert_func()(
+        page_offset, page_header_size + compressed_len, is_decompressed,
+        tmp_page_buffer_);
+    ARROW_UNUSED(ret);
+  } catch (...) {
+    // A cache implementation must not turn a readable file into a failed scan.
+  }
+}
