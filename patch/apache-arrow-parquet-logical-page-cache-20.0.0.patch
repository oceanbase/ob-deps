+std::shared_ptr<Page> SerializedPageReader::NextPageWithoutOffsetIndex() {
+  ThriftDeserializer deserializer(properties_);
+  const auto& read_range = properties_.without_offset_index_read_range_func();
+  if (!read_range) {
+    throw ParquetException("PageMgr range reader is not configured");
+  }
+  while (seen_num_values_ < total_num_values_) {
+    const int64_t page_offset = current_read_offset_;
+    const int64_t remaining = column_end_offset_ - page_offset;
+    if (remaining <= 0) {
+      ParquetException::EofException("Unexpected end of column chunk");
+    }
+    uint32_t header_size = 0;
+    bool cache_hit = false;
+    bool cache_header_available = false;
+    bool is_decompressed = false;
+    std::shared_ptr<Buffer> serialized_page;
+    std::shared_ptr<Buffer> page_buffer;
+    if (properties_.without_offset_index_cache_lookup_func()) {
+      const int ret = properties_.without_offset_index_cache_lookup_func()(
+          page_offset, serialized_page, cache_hit, is_decompressed);
+      cache_hit = ret == OB_SUCCESS && cache_hit && serialized_page != nullptr;
+    }
+    if (cache_hit) {
+      cache_hit = false;
+      if (serialized_page->size() <= std::numeric_limits<uint32_t>::max()) {
+        header_size = static_cast<uint32_t>(serialized_page->size());
+        current_page_header_ = format::PageHeader();
+        try {
+          deserializer.DeserializeMessage(serialized_page->data(), &header_size,
+                                          &current_page_header_, nullptr);
+          const int32_t compressed = current_page_header_.compressed_page_size;
+          const int32_t uncompressed = current_page_header_.uncompressed_page_size;
+          const int64_t payload_size = is_decompressed ? uncompressed : compressed;
+          cache_hit = compressed >= 0 && uncompressed >= 0 &&
+                      header_size <= max_page_header_size_ &&
+                      header_size <= serialized_page->size() &&
+                      serialized_page->size() - header_size == payload_size &&
+                      static_cast<int64_t>(header_size) + compressed <= remaining;
+        } catch (const std::exception&) {
+          // A stale or invalid cache entry can be recovered from storage.
+        }
+      }
+    }
+    if (!cache_hit) {
+      is_decompressed = false;
+      uint32_t allowed_size = std::min(kDefaultPageHeaderSize, max_page_header_size_);
+      while (true) {
+        const int64_t request_size = std::min<int64_t>(allowed_size, remaining);
+        if (read_range(page_offset, request_size, column_end_offset_, serialized_page) !=
+                OB_SUCCESS ||
+            serialized_page == nullptr || serialized_page->size() < request_size) {
+          throw ParquetException("PageMgr failed to read page header");
+        }
+        header_size = static_cast<uint32_t>(request_size);
+        current_page_header_ = format::PageHeader();
+        try {
+          deserializer.DeserializeMessage(serialized_page->data(), &header_size,
+                                          &current_page_header_, nullptr);
+          break;
+        } catch (const std::exception& e) {
+          if (request_size == remaining || allowed_size == max_page_header_size_) {
+            throw ParquetException("Deserializing page header failed: ", e.what());
+          }
+          allowed_size = static_cast<uint32_t>(std::min<int64_t>(
+              static_cast<int64_t>(allowed_size) * 2, max_page_header_size_));
+        }
+      }
+      if (properties_.without_offset_index_cache_insert_func()) {
+        cache_header_available =
+            tmp_page_header_cache_buffer_->Resize(header_size, false).ok();
+        if (cache_header_available) {
+          memcpy(tmp_page_header_cache_buffer_->mutable_data(), serialized_page->data(),
+                 header_size);
+        }
+      }
+    }
+    const int32_t compressed_len = current_page_header_.compressed_page_size;
+    const int32_t uncompressed_len = current_page_header_.uncompressed_page_size;
+    const int64_t physical_size = static_cast<int64_t>(header_size) + compressed_len;
