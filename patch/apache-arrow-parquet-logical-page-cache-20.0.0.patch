+TEST_F(TestPageSerde, DirectRangeCacheAllocationFailureDoesNotFailRead) {
+  class FailingPool final : public ::arrow::ProxyMemoryPool {
+   public:
+    FailingPool() : ProxyMemoryPool(::arrow::default_memory_pool()) {}
+    ::arrow::Status Allocate(int64_t size, int64_t alignment, uint8_t** out) override {
+      if (fail && size > 0) {
+        ++failures;
+        return ::arrow::Status::OutOfMemory("cache allocation test");
+      }
+      return ProxyMemoryPool::Allocate(size, alignment, out);
+    }
+    ::arrow::Status Reallocate(int64_t old_size, int64_t new_size, int64_t alignment,
+                              uint8_t** ptr) override {
+      if (fail && new_size > 0) {
+        ++failures;
+        return ::arrow::Status::OutOfMemory("cache allocation test");
+      }
+      return ProxyMemoryPool::Reallocate(old_size, new_size, alignment, ptr);
+    }
+    bool fail = false;
+    int failures = 0;
+  } pool;
+  data_page_header_.num_values = 1;
+  ASSERT_NO_FATAL_FAILURE(WriteDataPageHeader(1024, 4, 4));
+  ASSERT_OK(out_stream_->Write("data", 4));
+  EndStream();
+  ReaderProperties properties(&pool);
+  properties.set_page_read_mode_func([] { return PageReadMode::WITHOUT_OFFSET_INDEX; });
+  properties.set_without_offset_index_read_range_func(
+      [&](int64_t offset, int64_t length, int64_t, std::shared_ptr<Buffer>& buffer) {
+        buffer = std::make_shared<Buffer>(out_buffer_, offset, length);
+        return 0;
+      });
+  int insert_calls = 0;
+  properties.set_without_offset_index_cache_insert_func(
+      [&](int64_t, int64_t, bool, const std::shared_ptr<Buffer>&) {
+        ++insert_calls;
+        return -1;
+      });
+  auto reader = PageReader::Open(nullptr, 1, Compression::UNCOMPRESSED, properties, false,
+                                 nullptr, 0, out_buffer_->size());
+  pool.fail = true;
+  ASSERT_EQ("data", std::string_view(*reader->NextPage()->buffer()));
+  ASSERT_EQ(nullptr, reader->NextPage());
+  ASSERT_GT(pool.failures, 0);
+  ASSERT_EQ(0, insert_calls);
+  pool.fail = false;
+  reader = PageReader::Open(nullptr, 1, Compression::UNCOMPRESSED, properties, false,
+                            nullptr, 0, out_buffer_->size());
+  ASSERT_EQ("data", std::string_view(*reader->NextPage()->buffer()));
+  ASSERT_EQ(1, insert_calls);
+}
